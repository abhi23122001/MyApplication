rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isOwner(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    match /attendance/selfies/{uid}/{fileName} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    match /expenses/receipts/{uid}/{fileName} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    match /dsr/photos/{uid}/{fileName} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    match /billing/documents/{uid}/{fileName} {
      allow read, write: if isAdmin() || isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
