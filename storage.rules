rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userData().active == true && userData().role.matches('(?i)^ADMIN$');
    }

    function hasModule(module) {
      return isAdmin() || (
        signedIn() && userData().active == true && (
          userData().access.matches('(?i)(^|,)\\s*ALL\\s*(,|$)') ||
          userData().access.matches('(?i)(^|,)\\s*' + module + '\\s*(,|$)') ||
          (module == 'EXPENSE' && userData().access.matches('(?i)(^|,)\\s*EXPENSES\\s*(,|$)')) ||
          (module == 'DSR' && userData().access.matches('(?i)(^|,)\\s*DAILY_STATUS_REPORT\\s*(,|$)'))
        )
      );
    }

    function isOwner(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    match /attendance/selfies/{uid}/{fileName} {
      allow read, write: if isOwner(uid) && hasModule('ATTENDANCE');
      allow read, write: if isAdmin();
    }

    match /expenses/receipts/{uid}/{fileName} {
      allow read, write: if isOwner(uid) && hasModule('EXPENSE');
      allow read, write: if isAdmin();
    }

    match /dsr/photos/{uid}/{fileName} {
      allow read, write: if isOwner(uid) && hasModule('DSR');
      allow read, write: if isAdmin();
    }

    match /billing/documents/{uid}/{fileName} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
