rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActive() {
      return signedIn()
        && userData().get('active', false) == true
        && userData().get('approved', false) == true;
    }

    function isAdmin() {
      return isActive()
        && userData().get('role', '').matches('(?i)^ADMIN$');
    }

    function hasModule(module) {
      return isAdmin() || (
        isActive() && (
          userData().get('access', '').matches('(?i)(^|,)\\s*ALL\\s*(,|$)') ||
          userData().get('access', '').matches('(?i)(^|,)\\s*' + module + '\\s*(,|$)') ||
          (module == 'EXPENSE' && userData().get('access', '').matches('(?i)(^|,)\\s*EXPENSES\\s*(,|$)')) ||
          (module == 'DSR' && userData().get('access', '').matches('(?i)(^|,)\\s*DAILY_STATUS_REPORT\\s*(,|$)'))
        )
      );
    }

    function isOwner(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    // Attendance selfie:
    // Users can access only their own selfie folder.
    match /attendance/selfies/{uid}/{fileName} {
      allow read, write: if isOwner(uid);
    }

    // Expense receipts:
    // User must have EXPENSE access; admins have full access.
    match /expenses/receipts/{uid}/{fileName} {
      allow read, write: if isOwner(uid) && hasModule('EXPENSE');
      allow read, write: if isAdmin();
    }

    // DSR photos:
    // User must have DSR access; admins have full access.
    match /dsr/photos/{uid}/{fileName} {
      allow read, write: if isOwner(uid) && hasModule('DSR');
      allow read, write: if isAdmin();
    }

    // Billing documents:
    // Admin only.
    match /billing/documents/{uid}/{fileName} {
      allow read, write: if isAdmin();
    }

    // Everything else denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
