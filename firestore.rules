rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myUser() { return get(/databases/$(database)/documents/users/$(myUid())).data; }
    function isActive() { return signedIn() && myUser().active == true; }
    function isAdmin() { return isActive() && myUser().role.matches('(?i)^ADMIN$'); }
    function hasAccess(module) {
      return isAdmin() || (
        isActive() && (
          myUser().get('access', '').matches('(?i)(^|,)\\s*ALL\\s*(,|$)') ||
          myUser().get('access', '').matches('(?i)(^|,)\\s*' + module + '\\s*(,|$)') ||
          (module == 'EXPENSES' && myUser().get('access', '').matches('(?i)(^|,)\\s*EXPENSE\\s*(,|$)')) ||
          (module == 'PAYROLL' && myUser().get('access', '').matches('(?i)(^|,)\\s*SALARY\\s*(,|$)')) ||
          (module == 'ADVANCE' && myUser().get('access', '').matches('(?i)(^|,)\\s*ADVANCE_SALARY\\s*(,|$)'))
        )
      );
    }
    function ownUid(data) {
      return data.get('uid', '') == myUid() || data.get('userUid', '') == myUid() || data.get('employeeUid', '') == myUid();
    }
    function safeEmployeeAccess(access) {
      return access.matches('(?i)^[A-Z_]*(,[A-Z_]*)*$') &&
        !access.matches('(?i)(^|,)(ALL|ADMIN|ADMIN_HUB|PROJECTS|CLIENTS|BILLING|EQUIPMENT)(,|$)');
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == myUid() || isAdmin());
      allow create: if isAdmin() && uid != myUid() && request.resource.data.uid == uid &&
        request.resource.data.role.matches('(?i)^EMPLOYEE$') &&
        request.resource.data.active == true && request.resource.data.approved == true &&
        safeEmployeeAccess(request.resource.data.get('access', ''));
      allow create: if signedIn() && uid == myUid() &&
        request.resource.data.uid == myUid() &&
        request.resource.data.role.matches('(?i)^EMPLOYEE$') &&
        request.resource.data.active == true &&
        request.resource.data.approved == false &&
        request.resource.data.get('access', '') == '';
      allow update: if isAdmin();
      allow update: if signedIn() && uid == myUid() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.approved == resource.data.approved &&
        request.resource.data.access == resource.data.access &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcmToken', 'fcmTokenUpdatedAt', 'latitude', 'longitude',
          'locationSharing', 'lastLocationAt'
        ]);
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('ATTENDANCE') && ownUid(resource.data));
      allow create: if isAdmin() || (
        isActive() && hasAccess('ATTENDANCE') &&
        request.resource.data.uid == myUid() &&
        request.resource.data.get('punchInTime', null) <= request.time
      );
      allow update: if isAdmin() || (
        isActive() && hasAccess('ATTENDANCE') &&
        resource.data.uid == myUid() && request.resource.data.uid == myUid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'punchOutTime', 'punchOutLat', 'punchOutLng', 'workingMinutes', 'punchOutMissing'
        ]) && request.resource.data.punchOutMissing == false
      );
      allow delete: if isAdmin();
    }

    match /attendance_correction_requests/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('ATTENDANCE') && ownUid(resource.data));
      allow create: if isActive() && hasAccess('ATTENDANCE') && ownUid(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /expenses/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('EXPENSES') && ownUid(resource.data));
      allow create: if isAdmin() || (
        isActive() && hasAccess('EXPENSES') &&
        request.resource.data.uid == myUid() &&
        request.resource.data.get('status', 'PENDING') == 'PENDING' &&
        request.resource.data.get('paymentStatus', 'UNPAID') == 'UNPAID' &&
        request.resource.data.get('reviewedByUid', '') == '' &&
        request.resource.data.get('reviewedByName', '') == '' &&
        request.resource.data.get('paidByUid', '') == ''
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || (
        isActive() && hasAccess('EXPENSES') &&
        resource.data.uid == myUid() && resource.data.get('status', 'PENDING') == 'PENDING'
      );
    }

    match /advanceSalaryRequests/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('ADVANCE') && ownUid(resource.data));
      allow create: if isActive() && hasAccess('ADVANCE') && request.resource.data.uid == myUid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payroll/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('PAYROLL') && ownUid(resource.data));
      allow create, update, delete: if isAdmin();
    }

    match /salaryProfiles/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('PAYROLL') && ownUid(resource.data));
      allow create, update, delete: if isAdmin();
    }

    match /tasks/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('TASKS') && resource.data.assignedToUid == myUid());
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isActive() && hasAccess('TASKS') &&
        resource.data.assignedToUid == myUid() &&
        request.resource.data.assignedToUid == myUid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'updatedByUid'
        ]) && request.resource.data.updatedByUid == myUid()
      );
      allow delete: if isAdmin();
      match /history/{historyId} {
        allow read: if isAdmin() || (isActive() && hasAccess('TASKS') && get(/databases/$(database)/documents/tasks/$(id)).data.assignedToUid == myUid());
        allow create: if isAdmin() || (
          isActive() && hasAccess('TASKS') &&
          get(/databases/$(database)/documents/tasks/$(id)).data.assignedToUid == myUid() &&
          request.resource.data.get('actorUid', '') == myUid() &&
          request.resource.data.keys().hasOnly(['status', 'action', 'at', 'actorUid'])
        );
        allow update, delete: if isAdmin();
      }
    }

    match /leaveRequests/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('LEAVE') && ownUid(resource.data));
      allow create: if isActive() && hasAccess('LEAVE') && request.resource.data.userUid == myUid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /dsr/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('DSR') && ownUid(resource.data));
      allow create: if isActive() && hasAccess('DSR') && request.resource.data.uid == myUid();
      allow update, delete: if isAdmin();
    }

    match /team_messages/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('CHAT'));
      allow create: if isAdmin() || (isActive() && hasAccess('CHAT') && request.resource.data.senderUid == myUid());
      allow update, delete: if isAdmin() || (isActive() && hasAccess('CHAT') && resource.data.senderUid == myUid() && request.resource.data.senderUid == myUid());
    }

    match /direct_messages/{id} {
      allow read: if isAdmin() || (isActive() && hasAccess('CHAT') && resource.data.participants.hasAny([myUid()]));
      allow create: if isAdmin() || (isActive() && hasAccess('CHAT') && request.resource.data.senderUid == myUid() && request.resource.data.participants.hasAny([myUid()]));
      allow update, delete: if isAdmin() || (isActive() && hasAccess('CHAT') && resource.data.senderUid == myUid() && request.resource.data.senderUid == myUid());
    }

    match /announcements/{id} { allow read, write: if isAdmin(); }
    match /equipment/{id} { allow read, write: if isAdmin(); }
    match /projects/{id} { allow read, write: if isAdmin(); }
    match /employees/{id} {
      allow read: if isAdmin() || (isActive() && resource.data.uid == myUid());
      allow create, update, delete: if isAdmin();
    }
    match /clients/{id} { allow read, write: if isAdmin(); }
    match /billing/{id} { allow read, write: if isAdmin(); }
    match /invoices/{id} { allow read, write: if isAdmin(); }

    match /notifications/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.recipientUid == myUid() || resource.data.userUid == myUid() || resource.data.uid == myUid());
      allow create: if isAdmin() || (
        isActive() &&
        request.resource.data.uid == myUid() &&
        request.resource.data.targetRole.matches('(?i)^ADMIN$') &&
        request.resource.data.get('recipientUid', '') == ''
      );
      allow update, delete: if signedIn() && (isAdmin() || resource.data.recipientUid == myUid() || resource.data.userUid == myUid() || resource.data.uid == myUid());
    }

    match /config/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
